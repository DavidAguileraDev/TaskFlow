# Copy this file to .env.dev.local and replace the placeholders with local values.
# Start the database with: docker compose --env-file .env.dev.local up -d
APP_SECRET=replace_with_a_random_secret
DATABASE_URL="mysql://root:replace_with_local_password@127.0.0.1:33060/taskflowdb?serverVersion=8.3.0&charset=utf8mb4"
MYSQL_ROOT_PASSWORD=replace_with_local_password
MYSQL_DATABASE=taskflowdb
MYSQL_VERSION=8.3
